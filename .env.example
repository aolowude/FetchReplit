# Copy to .env and fill in values.
# cp .env.example .env

# ─── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL — use your Neon connection string (pooler URL recommended)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# OpenRouter (AI food scan + recipe generation)
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_INTEGRATIONS_OPENROUTER_API_KEY=

# ─── Local dev auth ──────────────────────────────────────────────────────────
# When 1, the API treats every request as the local dev user (no Replit OIDC).
DEV_AUTH=1
VITE_DEV_AUTH=1

# ─── Server ports ────────────────────────────────────────────────────────────
API_PORT=8080
WEB_PORT=5173

# ─── Optional ────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
