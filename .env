# ─── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/fetch

# OpenRouter (the AI helper reads these two specific names)
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_INTEGRATIONS_OPENROUTER_API_KEY=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

# ─── Local dev auth ──────────────────────────────────────────────────────────
# When 1, the API treats every request as the local dev user. This bypasses
# the Replit OIDC login flow so the app runs end-to-end on your laptop.
# Set to 0 (or remove) when wiring up real auth.
DEV_AUTH=1
VITE_DEV_AUTH=1

# ─── Server ports ────────────────────────────────────────────────────────────
# NOTE: PORT is intentionally not set here so the dev scripts can pick a
# different port per process. Defaults are in scripts/load-env.mjs:
#   dev:api  → PORT=8080
#   dev:web  → PORT=5173
#   dev:all  → both run side-by-side, no PORT override
API_PORT=8080
WEB_PORT=5173

# ─── Optional ────────────────────────────────────────────────────────────────

# Comma-separated origins allowed for credentialed cross-origin requests.
# Leave empty to deny all cross-origin (default). For local dev:
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Logging level (default: info)
# LOG_LEVEL=debug
